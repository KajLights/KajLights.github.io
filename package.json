{
  "name": "kajlights-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "prepare:source": "python3 scripts/prepare-source.py",
    "import:releases": "python3 scripts/import-releases.py",
    "build": "node scripts/build-notices.mjs && astro check && astro build",
    "predev": "node scripts/build-notices.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "astro preview --host 127.0.0.1",
    "format:check": "prettier --check src tests scripts/*.mjs *.mjs *.json .github/workflows/website.yml",
    "format": "prettier --write src tests scripts/*.mjs *.mjs *.json .github/workflows/website.yml"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "ajv": "8.20.0",
    "astro": "7.4.4",
    "crypto-js": "4.2.0",
    "esptool-js": "0.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/crypto-js": "4.2.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
